      "labelClasses" : [
        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "def FindLabel([HEI], [ZOR], [Obstruction_Type]):\n\n    h = [HEI]\n    z = [ZOR]\n    o = [Obstruction_Type]\n\n    # Convert HEI & ZOR\n    h_val = str(int(round(float(h)))) if h not in [None, \"\"] else \"\"\n    z_val = str(int(round(float(z)))) if z not in [None, \"\"] else \"\"\n\n    # Handle domain value\n    obstruction_dict = {\n        1: \"Tower\",\n        2: \"Building\",\n        3: \"Telecom\",\n        4: \"Pylon\",\n        5: \"Cable Car S.\",\n        999: \"Others\",\n        0: \"Unknown\"\n    }\n\n    # If already text/domain description\n    if isinstance(o, str):\n        obstruction_val = o\n    else:\n        obstruction_val = obstruction_dict.get(o, \"\")\n\n    # Final label\n    label = (\n        \"<ALIGN horizontal='center'>\"\n        + obstruction_val\n        + \"\\n<BOL>\" + z_val + \"</BOL>\"\n        + \"\\n(\" + h_val + \")\"\n        + \"</ALIGN>\"\n    )\n\n    return label",
          "expressionEngine" : "Python",
          "featuresToLabel" : "AllVisibleFeatures",
